---
/*
  The checkout overlay.

  Card fields are served by Authorize.Net inside the iframe below. Nothing in
  this component — and nothing anywhere on this site — may read, store or
  forward a card number. That boundary is what keeps the merchant in PCI
  SAQ A. If you find yourself adding an input for a card here, stop.

  Flow:
    1. Button posts {product, option} to the Lambda. No price: see the note in
       infra/lambda/index.mjs.
    2. Lambda returns a single-use form token.
    3. We POST that token to Authorize.Net, targeting the iframe.
    4. The iframe talks back through /checkout/communicator/.
*/

import logo from '../assets/logo-dark.png'

const endpoint = import.meta.env.PUBLIC_CHECKOUT_ENDPOINT ?? ''
---

<dialog class="checkout" data-checkout aria-label="Payment">
  {/* A real header rather than a CSS ::before, so the wordmark can be an
      actual image. The artwork is white-on-transparent, which is why the bar
      stays black in both themes — same reasoning as the site masthead.

      It matters more here than it looks: this is a full-screen page asking for
      a card number. Someone who cannot see whose site they are on has every
      reason to hesitate, and should. */}
  <header class="bar">
    <img
      class="mark"
      src={logo.src}
      alt="Beast Fitness"
      width={logo.width}
      height={logo.height}
    />
    <span class="secure">Secure payment</span>
    <button type="button" class="x" data-checkout-close aria-label="Close payment">×</button>
  </header>

  <p class="status" data-checkout-status>Loading payment form…</p>

  {/* name is what the POST targets; Authorize.Net renders into it. */}
  {/* scrolling is left to the browser. It used to be "no", which only worked
      because the frame was resized to fit its content — with a fixed
      full-screen height, a form taller than the viewport would simply be cut
      off with no way to reach the Pay button. */}
  <iframe
    name="authnet"
    data-checkout-frame
    title="Secure payment form"
    frameborder="0"
  ></iframe>

  {/* Built and submitted by script. Kept in the DOM rather than created ad hoc
      so the target/iframe relationship is visible when debugging. */}
  <form
    method="post"
    target="authnet"
    action=""
    data-checkout-form
    hidden
  >
    <input type="hidden" name="token" data-checkout-token />
  </form>
</dialog>

<script define:vars={{ endpoint }}>
  const dlg = document.querySelector('[data-checkout]')
  if (dlg) {
    const frame = dlg.querySelector('[data-checkout-frame]')
    const form = dlg.querySelector('[data-checkout-form]')
    const tokenField = dlg.querySelector('[data-checkout-token]')
    const status = dlg.querySelector('[data-checkout-status]')

    const setStatus = (msg) => {
      status.textContent = msg
      status.hidden = !msg
    }

    const close = () => {
      dlg.close()
      // Blank the frame so a closed overlay is never holding a live payment
      // session, and so reopening always starts clean.
      frame.src = 'about:blank'
    }

    dlg.querySelector('[data-checkout-close]').addEventListener('click', close)
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault()
      close()
    })

    async function open(product, option) {
      setStatus('Loading payment form…')
      dlg.showModal()

      if (!endpoint) {
        setStatus('Checkout is not configured yet. Please call or use the contact form.')
        return
      }

      let data
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ product, option }),
        })
        data = await res.json()
        if (!res.ok) throw new Error(data.error ?? res.status)
      } catch (err) {
        console.error('checkout', err)
        setStatus('Sorry — we could not start the payment. Please try again, or contact us.')
        return
      }

      setStatus('')
      form.action = data.action
      tokenField.value = data.token
      form.submit()
    }

    /* Anything with data-buy opens the overlay. The attributes carry the
       catalog keys, not prices. */
    for (const el of document.querySelectorAll('[data-buy]')) {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        open(el.dataset.product, el.dataset.option)
      })
    }

    /* Messages arrive from /checkout/communicator/, which is same-origin, so
       anything from another origin is discarded outright. */
    window.addEventListener('message', (e) => {
      if (e.origin !== window.location.origin) return
      if (typeof e.data !== 'string') return

      const params = new URLSearchParams(e.data)
      const action = params.get('action')

      if (action === 'resizeWindow') {
        /* Deliberately ignored. The frame fills the screen and scrolls itself,
           so honouring this would shrink a full-screen form back to whatever
           the gateway thinks it needs — and reintroduce the failure where a
           missing message leaves a blank box. Kept as a branch so it is clear
           the message is handled, not overlooked. */
      } else if (action === 'cancel') {
        close()
      } else if (action === 'transactResponse') {
        /* The response is informational only — it comes from the browser and
           must never be treated as proof of payment. Settlement is confirmed
           server-side by the webhook before anything is fulfilled. */
        close()
        window.location.href = '/checkout/thank-you/'
      }
    })
  }
</script>

<style>
  /* Full screen.

     The hosted form's width is not ours to set, so a narrow dialog around it
     left the form floating in a box that did not fit it. Taking the whole
     viewport removes the mismatch entirely: there is no container edge for the
     form to be misaligned against.

     It also suits what this is. Paying is a single-task moment — the rest of
     the page is not something anyone needs mid-transaction, and on a phone a
     94vw dialog was effectively full screen anyway. */
  .checkout {
    border: 0;
    border-radius: 0;
    background: var(--surface);
    padding: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;

    /* Not overflow:hidden. A payment form that overflows must stay reachable —
       hiding it means a customer can see a field they cannot get to, with
       nothing to indicate why. */
    overflow: auto;
    display: flex;
    flex-direction: column;
  }
  .checkout::backdrop { background: rgba(0, 0, 0, 0.85); }

  /* Always black, in both themes — the wordmark is white-on-transparent. */
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
    background: #0a0a0a;
    border-bottom: 3px solid var(--green);
    padding: 0.75rem 1.25rem;
  }
  .bar .mark {
    height: 1.9rem;
    width: auto;
    display: block;
  }
  .bar .secure {
    font-family: var(--brand);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-bright);
    margin-right: auto;
  }

  /* In the bar now, not floating over the form. */
  .x {
    flex: none;
    background: transparent;
    border: 0;
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
  }
  .x:hover, .x:focus-visible { color: var(--green-bright); }

  .status {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }
  .status[hidden] { display: none; }

  /* Fills whatever is left under the brand bar, so the form is never sized by
     a message that might not arrive.

     This used to be height:0, growing only on resizeWindow from the
     communicator. That made the whole lightbox depend on one postMessage: if
     the communicator page was unreachable, late, or on a different origin, the
     customer saw a blank box while the form loaded fine behind it at zero
     height. Filling the container removes that dependency — resizeWindow is
     now a refinement rather than the thing standing between a customer and a
     visible payment form. */
  iframe {
    display: block;
    flex: 1;
    min-height: 0;
    border: 0;

    /* Centred column rather than full-bleed. The hosted form is responsive, so
       it fills whatever width it is given — across a 1280px desktop that left
       a short form stranded in a white expanse. A reading-width column looks
       deliberate and matches the rest of the site.

       Still 100% on a phone, where the viewport is already narrower than the
       cap. */
    width: min(100%, 44rem);
    margin-inline: auto;
  }
</style>
