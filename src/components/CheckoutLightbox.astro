---
/*
  The checkout overlay.

  Card fields are served by Authorize.Net inside the iframe below. Nothing in
  this component — and nothing anywhere on this site — may read, store or
  forward a card number. That boundary is what keeps the merchant in PCI
  SAQ A. If you find yourself adding an input for a card here, stop.

  Flow:
    1. Button posts {product, option} to the Lambda. No price: see the note in
       infra/lambda/index.mjs.
    2. Lambda returns a single-use form token.
    3. We POST that token to Authorize.Net, targeting the iframe.
    4. The iframe talks back through /checkout/communicator/.
*/

import logo from '../assets/logo-dark.png'

const endpoint = import.meta.env.PUBLIC_CHECKOUT_ENDPOINT ?? ''
---

<dialog class="checkout" data-checkout aria-label="Payment">
  {/* A real header rather than a CSS ::before, so the wordmark can be an
      actual image. The artwork is white-on-transparent, which is why the bar
      stays black in both themes — same reasoning as the site masthead.

      It matters more here than it looks: this is a full-screen page asking for
      a card number. Someone who cannot see whose site they are on has every
      reason to hesitate, and should. */}
  <header class="site-header">
    <div class="wrap bar">
      {/* Not a link. On the masthead the wordmark goes home; here that would
          abandon a payment halfway through, which is what the close button is
          for — and that one at least warns nothing has been charged. */}
      <span class="site-title">
        <img src={logo.src} alt="Beast Fitness" width={logo.width} height={logo.height} />
      </span>

      <span class="secure">Secure payment</span>

      <button type="button" class="x" data-checkout-close aria-label="Close payment">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" fill="none"></path>
        </svg>
      </button>
    </div>
  </header>

  {/* What is being bought, above the form.

      Filled from the Lambda's response, not from the button that opened this.
      The server resolves the price from the catalog, so the figure shown here
      is the figure being charged — a summary built from the page's own idea of
      the price could disagree with the transaction and nobody would know until
      a customer complained.

      Above the loader in the markup, deliberately. The loader is flex:1, so a
      summary declared after it gets pushed to the bottom of the screen while
      both are visible — then jumps to the top when the loader hides. */}
  <div class="summary" data-checkout-summary hidden>
    <div class="wrap summary-inner">
      <span class="summary-what">
        <strong data-summary-product></strong>
        <span data-summary-option></span>
      </span>
      <span class="summary-amount" data-summary-amount></span>
    </div>
  </div>

  {/* Shown until the hosted form is in the frame. The frame itself stays
      hidden until then: an empty bordered panel with a green edge reads as a
      form that failed to load, which is worse than showing nothing. */}
  <div class="loading" data-checkout-loading>
    <span class="spinner" aria-hidden="true"></span>
    <p>Opening secure payment…</p>
    <p class="loading-sub">You are being connected to our payment provider.</p>
  </div>

  <p class="status" data-checkout-status hidden></p>

  {/* Covers the frame once the card has been submitted.

      role=alert so the state change is announced rather than only drawn — a
      customer using a screen reader otherwise gets silence at the exact moment
      they most need to know something is happening. */}
  <div class="processing" data-checkout-processing hidden role="alert">
    <div class="processing-box">
      <span class="spinner" aria-hidden="true"></span>
      <p><strong>Processing your payment…</strong></p>
      <p class="processing-sub">
        Do not close this window or press back. This can take a few moments.
      </p>
    </div>
  </div>

  {/* name is what the POST targets; Authorize.Net renders into it. */}
  {/* scrolling is left to the browser. It used to be "no", which only worked
      because the frame was resized to fit its content — with a fixed
      full-screen height, a form taller than the viewport would simply be cut
      off with no way to reach the Pay button. */}
  <iframe
    name="authnet"
    data-checkout-frame
    title="Secure payment form"
    frameborder="0"
  ></iframe>

  {/* Built and submitted by script. Kept in the DOM rather than created ad hoc
      so the target/iframe relationship is visible when debugging. */}
  <form
    method="post"
    target="authnet"
    action=""
    data-checkout-form
    hidden
  >
    <input type="hidden" name="token" data-checkout-token />
  </form>
</dialog>

<script define:vars={{ endpoint }}>
  const dlg = document.querySelector('[data-checkout]')
  if (dlg) {
    const frame = dlg.querySelector('[data-checkout-frame]')
    const form = dlg.querySelector('[data-checkout-form]')
    const tokenField = dlg.querySelector('[data-checkout-token]')
    const status = dlg.querySelector('[data-checkout-status]')
    const loading = dlg.querySelector('[data-checkout-loading]')
    const summary = dlg.querySelector('[data-checkout-summary]')
    const processing = dlg.querySelector('[data-checkout-processing]')
    const closeBtn = dlg.querySelector('[data-checkout-close]')

    /* Once the card is submitted there is no safe way out of this screen.
     *
     * The Pay button is inside Authorize.Net's iframe, so its click is not
     * observable from here — what IS observable is the frame navigating away
     * from the form, which is the submit. From that moment the charge may
     * already have been authorised, and closing would leave someone believing
     * they had cancelled something that in fact went through.
     *
     * So the close button goes, Escape is refused, and an overlay says what is
     * happening. It is lifted again by transactResponse or cancel arriving, or
     * by an error. */
    let processingPayment = false

    const setProcessing = (on) => {
      processingPayment = on
      processing.hidden = !on
      closeBtn.hidden = on
    }

    /* The frame is revealed when the hosted form has actually rendered in it,
       not when the POST is fired. The load event fires for about:blank too, so
       a flag tracks whether a form was submitted into it — otherwise the
       loader disappears the instant the dialog opens. */
    let awaitingForm = false
    let formShown = false
    frame.addEventListener('load', () => {
      if (awaitingForm) {
        awaitingForm = false
        formShown = true
        loading.hidden = true
        frame.hidden = false
        return
      }
      /* A second navigation once the form is up means the customer pressed
         Pay and the gateway is working. */
      if (formShown) setProcessing(true)
    })

    /* Loader visible, frame and error hidden. The starting state, and the
       state to return to when reopening — otherwise a second attempt after a
       failure opens straight onto the previous error. */
    const showLoading = () => {
      setProcessing(false)
      formShown = false
      summary.hidden = true
      loading.hidden = false
      frame.hidden = true
      status.hidden = true
      status.textContent = ''
      status.classList.remove('is-error')
    }

    /* What a customer sees when it goes wrong.
     *
     * "gateway_refused" in a console is fine for us and useless to them. Each
     * of these says what happened and what to do about it, and every one is
     * explicit that no money has been taken — that is the question someone
     * actually has when a payment screen fails, and leaving it unanswered is
     * how you get a duplicate attempt or an angry phone call.
     *
     * The code is shown in small print so a support conversation can start
     * with a fact rather than "it didn't work". */
    const MESSAGES = {
      rate_limited:
        'Too many attempts in a short time. Please wait a minute and try again — nothing has been charged.',
      unknown_product:
        'That item is not available to buy online right now. Please contact us and we will sort it out — nothing has been charged.',
      unknown_option:
        'That option is not available to buy online right now. Please contact us — nothing has been charged.',
      origin_not_allowed:
        'Payments are not enabled on this address. Please use beast-fit.com — nothing has been charged.',
      not_configured:
        'Online payment is not set up yet. Please contact us to pay another way — nothing has been charged.',
      gateway_refused:
        'Our payment provider turned the request away. This is our problem, not your card — nothing has been charged. Please contact us.',
      gateway_unreachable:
        'We could not reach our payment provider. Please try again in a minute — nothing has been charged.',
      gateway_bad_response:
        'Our payment provider sent something we could not read. Please try again, or contact us — nothing has been charged.',
      unreachable:
        'Could not reach us — check your connection and try again. Nothing has been charged.',
    }

    const fail = (code) => {
      setProcessing(false)
      /* The frame is empty here and the loader is lying — neither should stay
         on screen behind an error. */
      awaitingForm = false
      loading.hidden = true
      frame.hidden = true
      summary.hidden = true
      status.hidden = false
      status.classList.add('is-error')
      status.textContent =
        MESSAGES[code] ??
        'Something went wrong starting the payment. Please try again, or contact us — nothing has been charged.'

      // A way out, and a way to reach a human, without hunting for the X.
      const actions = document.createElement('span')
      actions.className = 'status-actions'
      const contact = document.createElement('a')
      contact.href = '/contact/'
      contact.textContent = 'Contact us'
      const ref = document.createElement('span')
      ref.className = 'status-code'
      ref.textContent = `reference: ${code}`
      actions.append(contact, ref)
      status.appendChild(actions)
    }

    const close = () => {
      dlg.close()
      awaitingForm = false
      formShown = false
      setProcessing(false)
      // Blank the frame so a closed overlay is never holding a live payment
      // session, and so reopening always starts clean.
      frame.src = 'about:blank'
    }

    closeBtn.addEventListener('click', () => {
      if (processingPayment) return
      close()
    })

    /* Escape is always prevented — the default would close the dialog outright,
       skipping the frame teardown in close(). While a payment is in flight it
       is refused entirely. */
    dlg.addEventListener('cancel', (e) => {
      e.preventDefault()
      if (processingPayment) return
      close()
    })

    async function open(product, option) {
      showLoading()
      dlg.showModal()

      if (!endpoint) {
        fail('not_configured')
        return
      }

      let data
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ product, option }),
        })
        data = await res.json().catch(() => ({}))
        if (!res.ok) throw Object.assign(new Error(data.error ?? `http_${res.status}`), { code: data.error })
      } catch (err) {
        console.error('checkout', err)
        fail(err.code ?? (err.name === 'TypeError' ? 'unreachable' : 'unknown'))
        return
      }

      /* textContent, not innerHTML — these strings come back over the wire and
         land next to a card form. */
      if (data.summary) {
        summary.querySelector('[data-summary-product]').textContent = data.summary.product ?? ''
        summary.querySelector('[data-summary-option]').textContent = data.summary.option ?? ''
        summary.querySelector('[data-summary-amount]').textContent =
          data.summary.amount ? `$${data.summary.amount}` : ''
        summary.hidden = false
      }

      form.action = data.action
      tokenField.value = data.token
      awaitingForm = true
      form.submit()
    }

    /* Anything with data-buy opens the overlay. The attributes carry the
       catalog keys, not prices. */
    for (const el of document.querySelectorAll('[data-buy]')) {
      el.addEventListener('click', (e) => {
        e.preventDefault()
        open(el.dataset.product, el.dataset.option)
      })
    }

    /* Messages arrive from /checkout/communicator/, which is same-origin, so
       anything from another origin is discarded outright. */
    window.addEventListener('message', (e) => {
      if (e.origin !== window.location.origin) return
      if (typeof e.data !== 'string') return

      const params = new URLSearchParams(e.data)
      const action = params.get('action')

      if (action === 'resizeWindow') {
        /* Deliberately ignored. The frame fills the screen and scrolls itself,
           so honouring this would shrink a full-screen form back to whatever
           the gateway thinks it needs — and reintroduce the failure where a
           missing message leaves a blank box. Kept as a branch so it is clear
           the message is handled, not overlooked. */
      } else if (action === 'cancel') {
        close()
      } else if (action === 'transactResponse') {
        /* The response is informational only — it comes from the browser and
           must never be treated as proof of payment. Settlement is confirmed
           server-side by the webhook before anything is fulfilled. */
        close()
        window.location.href = '/checkout/thank-you/'
      }
    })
  }
</script>

<style>
  /* Full screen.

     The hosted form's width is not ours to set, so a narrow dialog around it
     left the form floating in a box that did not fit it. Taking the whole
     viewport removes the mismatch entirely: there is no container edge for the
     form to be misaligned against.

     It also suits what this is. Paying is a single-task moment — the rest of
     the page is not something anyone needs mid-transaction, and on a phone a
     94vw dialog was effectively full screen anyway. */
  .checkout {
    border: 0;
    border-radius: 0;

    /* The same grass the rest of the site sits on, veil included — the tokens
       come from global.css, so it follows the theme without a second
       definition to keep in step.

       Worth it because this is the one screen a customer reaches that renders
       none of our own markup below the header. Without it, the page they type
       a card number into looks like a different site to the one they were just
       browsing. */
    background-color: var(--bg);
    background-image: linear-gradient(var(--grass-veil), var(--grass-veil)), url('/grass.webp');
    background-position: left top;
    background-size: auto;
    background-repeat: repeat;
    padding: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;

    /* Not overflow:hidden. A payment form that overflows must stay reachable —
       hiding it means a customer can see a field they cannot get to, with
       nothing to indicate why. */
    overflow: auto;

    /* Positioning context for the processing overlay. */
    position: fixed;
  }

  /* Scoped to [open], and it must be.
   *
   * The browser hides a closed dialog with `display: none`. Declaring
   * `display: flex` on the element itself overrides that, so the closed dialog
   * stays in the layout — an empty full-height block sitting at the bottom of
   * every page that includes this component. That is the stray whitespace, and
   * the reason it appeared to render at the bottom. */
  .checkout[open] {
    display: flex;
    flex-direction: column;
  }
  .checkout::backdrop { background: rgba(0, 0, 0, 0.85); }

  /* Matched to the site masthead, using the same tokens rather than copies of
     its values — so restyling the header restyles this too instead of leaving
     the payment page as the one screen that looks slightly off. */
  .site-header {
    flex: none;
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-hairline);
    color: var(--header-text);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
  }

  .site-title {
    display: inline-flex;
    align-items: center;
    margin-right: auto;
    line-height: 0;
  }

  .site-title img {
    height: 2.2rem;
    width: auto;
  }

  .secure {
    font-family: var(--brand);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-bright);
  }

  /* Same box as the masthead's menu button: the two controls sit in the same
     place on screen, so they should look like the same kind of thing. */
  .x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--header-control);
    border-radius: 6px;
    color: var(--header-text);
    cursor: pointer;
  }
  .x:hover,
  .x:focus-visible {
    border-color: var(--green);
    color: var(--green-bright);
  }

  @media (max-width: 30rem) {
    .secure { display: none; } /* the padlock is the browser's job at this size */
  }

  /* The loader. Occupies the same column the form will, so revealing the form
     does not shift the page — the loader is not a placeholder that vanishes
     and lets everything jump. */
  .loading {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--text);
  }

  /* On a panel, not on the grass. Body text straight onto the tile is
     unreadable — the same reason every other page puts its content on a
     surface. */
  .loading > * {
    position: relative;
    z-index: 1;
  }
  .loading::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(100% - 2.5rem, 26rem);
    height: 13rem;
    background: var(--surface);
    border: 1px solid var(--edge);
    border-top: 3px solid var(--green);
    box-shadow: var(--shadow);
  }
  .loading p { margin: 0; }
  .loading-sub { font-size: 0.85rem; color: var(--text-muted); }

  .spinner {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    border: 3px solid var(--hairline);
    border-top-color: var(--green);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Respect a stated preference for less motion: pulse rather than spin. A
     payment screen is not the place to ignore that. */
  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: pulse 1.4s ease-in-out infinite;
      border-top-color: var(--green);
    }
    @keyframes pulse { 50% { opacity: 0.35; } }
  }

  /* Sits between the header and the form, on the same column, so it reads as
     part of the page rather than something floating over it. */
  .summary {
    flex: none;
    background: var(--panel);
    border-bottom: 1px solid var(--hairline);
  }

  .summary-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 0.85rem;
    max-width: var(--page-max);
  }

  .summary-what {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.9rem;
  }
  .summary-what span { color: var(--text-muted); font-size: 0.85rem; }

  .summary-amount {
    font-family: var(--brand);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--link);
    font-variant-numeric: tabular-nums;
  }

  /* Over the frame, not instead of it. The form stays mounted underneath —
     tearing it down mid-transaction would abandon whatever the gateway is
     doing in there. */
  .processing {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(2px);
  }

  .processing-box {
    max-width: 26rem;
    width: 100%;
    text-align: center;
    padding: 2rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--edge);
    border-top: 3px solid var(--green);
    box-shadow: var(--shadow);
  }
  .processing-box p { margin: 0.35rem 0 0; }
  .processing-sub { font-size: 0.85rem; color: var(--text-muted); }

  .status {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--text-muted);
  }

  /* An error is not a loading message. It gets the panel treatment so it does
     not read as "still working" — the state people misread as "wait longer"
     and then retry into. */
  .status.is-error {
    max-width: 34rem;
    margin: 2rem auto;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--edge);
    border-top: 3px solid #d08a1f;
    color: var(--text);
    text-align: left;
    box-shadow: var(--shadow);
  }

  /* :global because these elements are built by the script. Astro scopes
     styles with a data attribute stamped onto elements in the template, and
     anything from document.createElement never receives it — so the scoped
     rules silently did not apply and the link ran inline with the sentence. */
  :global(.status-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
    margin-top: 1rem;
  }
  :global(.status-actions a) { font-weight: 700; }
  :global(.status-code) {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Fills whatever is left under the brand bar, so the form is never sized by
     a message that might not arrive.

     This used to be height:0, growing only on resizeWindow from the
     communicator. That made the whole lightbox depend on one postMessage: if
     the communicator page was unreachable, late, or on a different origin, the
     customer saw a blank box while the form loaded fine behind it at zero
     height. Filling the container removes that dependency — resizeWindow is
     now a refinement rather than the thing standing between a customer and a
     visible payment form. */
  /* [hidden] must win over display:block.
   *
   * The hidden attribute works by way of a UA rule of display:none, and any
   * display declaration on the element overrides it. Without this the frame
   * stayed on screen while "hidden" — its green top border showing as a line
   * across the page behind the error. Same trap as declaring display on the
   * dialog itself, which kept the closed dialog in the layout. */
  iframe {
    display: block;
    flex: 1;
    min-height: 0;
    border: 0;

    /* Same box as the panels on contact, training and the product pages.
       --page-max and the 1.25rem inline padding are .wrap's own values, so the
       form sits on exactly the column everything else does rather than a width
       picked for this one screen.

       No padding subtracted: .wrap's 1.25rem is inside its box, insetting its
       contents rather than narrowing the box itself. Taking it off here made
       the frame 40px narrower than the panel at every width below the cap. */
    width: min(100%, var(--page-max));
    margin-inline: auto;
  }

  /* Breathing room so the grass reads as background rather than a stripe down
     each side, and the form sits on it as a panel — matching how every other
     page puts its content on a surface above the tile.

     Not on a phone: there the form needs every pixel of width more than it
     needs framing. */
  /* Panel treatment, same tokens as main.panel. No bottom margin: the form
     runs from under the header to the bottom of the screen, so there is no
     strip of grass beneath it to suggest the page continues when it does not.

     Only from 48rem up. On a phone the form needs every pixel of width more
     than it needs framing. */
  @media (min-width: 48rem) {
    .checkout iframe {
      margin-block: 0;
      border: 1px solid var(--hairline);
      border-top: 3px solid var(--green);
      box-shadow: var(--shadow);
    }
  }
</style>
